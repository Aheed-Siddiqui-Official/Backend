<%- include('../partials/head') %>
</head>
<body class="bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen">
    <%- include('../partials/nav') %>
    <main class="container mx-auto px-4 py-16 max-w-6xl">
        <div class="bg-white shadow-xl rounded-3xl overflow-hidden border border-gray-100">
            <!-- Hero Section -->
            <div class="relative h-[60vh] min-h-[400px]">
                <img 
                    src="<%= home.photo %>" 
                    alt="<%= home.houseName %>" 
                    class="w-full h-full object-cover"
                    onerror="this.src='/images/default-home.jpg'"
                >
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-12">
                    <h1 class="text-5xl font-bold text-white mb-4 drop-shadow-lg">
                        <%= home.houseName %>
                    </h1>
                    <p class="text-white/90 text-xl flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        </svg>
                        <%= home.location %>
                    </p>
                </div>
                <div class="absolute top-6 right-6">
                    <%- include('../partials/favourite') %>
                </div>
            </div>

            <!-- Content Section -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 p-12">
                <!-- Main Info -->
                <div class="lg:col-span-2 space-y-10">
                    <div class="bg-gray-50 rounded-2xl p-8">
                        <h3 class="text-2xl font-semibold mb-6 text-gray-800">About this place</h3>
                        <p class="text-gray-600 leading-relaxed text-lg"><%= home.description %></p>
                    </div>
                </div>

                <!-- Property Details -->
                <div class="space-y-6">
                    <!-- Price Card -->
                    <div class="bg-gray-50 rounded-2xl p-8">
                        <div class="flex items-baseline mb-4">
                            <span class="text-4xl font-bold text-red-500">Rs.<%= home.price %></span>
                            <span class="text-gray-600 ml-2">per night</span>
                        </div>
                        <div class="flex items-center mb-6">
                            <div class="bg-white p-2 rounded-lg shadow-sm">
                                <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <span class="ml-2 font-semibold"><%= home.rating %> / 5</span>
                        </div>
                        <button class="w-full bg-red-500 text-white py-4 rounded-xl hover:bg-red-600 transition-colors duration-300 font-medium text-lg">
                            Book Now
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>