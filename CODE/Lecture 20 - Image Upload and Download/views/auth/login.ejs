<%- include('../partials/head.ejs') %>
</head>
<body class="bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen">
  <%- include('../partials/nav') %>

  <main class="flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
      <div class="px-8 py-10">
        <div class="text-center mb-6">
          <svg class="mx-auto h-10 w-10 text-red-500 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c1.657 0 3-1.343 3-3S13.657 2 12 2 9 3.343 9 5s1.343 3 3 3zM4 20a8 8 0 0116 0" />
          </svg>
          <h1 class="text-2xl font-semibold text-gray-900">Welcome back</h1>
          <p class="mt-1 text-sm text-gray-600">Sign in to your account to continue</p>
        </div>

        <form action="/login" method="POST" class="space-y-5">

          <%- include('../partials/errors') %>

          <div class="relative">
            <label for="email" class="sr-only">Email</label>
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
               <svg class="w-5 h-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 12H8m8 0a4 4 0 01-4 4H8a4 4 0 01-4-4V8a4 4 0 014-4h4a4 4 0 014 4v4z"/>
              </svg>
            </div>

            <input
              id="email"
              name="email"
              type="email"
              required
              value="<%= oldInput && oldInput.email ? oldInput.email : '' %>"
              placeholder="muhammad.ahmed@gmail.com"
              class="w-full pl-10 pr-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent placeholder-gray-400 transition-shadow"
              aria-label="Email address"
            />
          </div>

          <div class="relative">
            <label for="password" class="sr-only">Password</label>
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 11c.667 0 1.333-.333 2-1m-4 1c0 .667.333 1 1 1m0-2v-1a2 2 0 112 2v1m-5 4h8" />
              </svg>
            </div>

            <input
              id="password"
              name="password"
              type="password"
              required
              placeholder="Enter your password"
              class="w-full pl-10 pr-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent placeholder-gray-400 transition-shadow"
              aria-label="Password"
            />
          </div>

          <input 
            type="submit"
            value="Sign In"
            class="w-full mt-1 bg-red-500 hover:bg-red-600 text-white py-3 rounded-lg font-semibold shadow-sm hover:shadow-md transition-colors duration-200 cursor-pointer"
          />

          <p class="mt-4 text-center text-sm text-gray-600">
            Don't have an account?
            <a href="/signup" class="text-red-500 font-medium hover:text-red-600">Create account</a>
          </p>
        </form>
      </div>
    </div>
  </main>
</body>
</html>