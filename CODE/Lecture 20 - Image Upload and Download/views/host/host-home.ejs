<%- include('../partials/head') %>
</head>
<body class="bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen">
    <%- include('../partials/nav') %>
    <main class="container mx-auto px-6 py-16 max-w-7xl">
        <div class="text-center mb-12">
            <h2 class="text-4xl font-bold text-gray-900 mb-4">
                Manage Your Properties
                <span class="block text-xl font-normal text-gray-600 mt-2">
                    View and manage all your listed properties
                </span>
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% registeredHomes.forEach(home => { %>
                <div class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 border border-gray-100">
                    <!-- Image Container -->
                    <div class="relative h-64">
                        <img 
                            src="<%= home.photo%>" 
                            alt="<%= home.houseName %>" 
                            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                            onerror="this.src='/images/default-home.jpg'"
                        >
                        <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
                    </div>

                    <!-- Content Container -->
                    <div class="p-6 space-y-4">
                        <h3 class="text-2xl font-semibold text-gray-800"><%= home.houseName %></h3>
                        
                        <div class="flex items-center text-gray-600">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            </svg>
                            <span class="ml-2"><%= home.location %></span>
                        </div>

                        <div class="flex justify-between items-center py-4 border-t border-gray-100">
                            <div class="flex items-center space-x-1">
                                <span class="text-2xl font-bold text-red-500">Rs.<%= home.price %></span>
                                <span class="text-gray-600">/night</span>
                            </div>
                            <div class="flex items-center bg-gray-50 px-3 py-1 rounded-full">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-yellow-400">
                                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                                </svg>
                                <span class="ml-1 font-medium"><%= home.rating %></span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex gap-4 pt-2">
                            <a href="/host/edit-home/<%=home._id%>?editing=true" 
                               class="flex-1 inline-flex justify-center items-center px-4 py-2.5 bg-blue-500 hover:bg-blue-600 text-white rounded-xl transition duration-300 font-medium text-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                                Edit
                            </a>
                            <form action="/host/delete-home/<%= home._id %>" method="POST" class="flex-1">
                                <button type="submit" 
                                        class="w-full inline-flex justify-center items-center px-4 py-2.5 bg-red-500 hover:bg-red-600 text-white rounded-xl transition duration-300 font-medium text-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>
</body>
</html>