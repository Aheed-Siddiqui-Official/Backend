<%- include('../partials/head') %>
</head>
<body class="bg-gradient-to-br from-gray-50 to-gray-100">
  <%- include('../partials/nav') %>
  <main class="container mx-auto px-4 py-16 max-w-7xl">
    <div class="text-center mb-16">
      <h2 class="text-5xl font-bold text-gray-900 mb-4">
        Discover Amazing Places
      </h2>
      <p class="mt-4 text-xl text-gray-600 max-w-2xl mx-auto">Find your perfect stay from our curated collection of premium properties</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      <% registeredHomes.forEach(home => { %>
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 border border-gray-100">
          <!-- Image Container -->
          <div class="relative h-72">
            <img 
              src="<%= home.photoUrl %>" 
              alt="<%= home.houseName %>" 
              class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
              onerror="this.src='/images/default-home.jpg'"
            >
            <div class="absolute top-4 right-4 z-10">
              <%- include('../partials/favourite', {home: home}) %>
            </div>
          </div>

          <!-- Content Container -->
          <div class="p-8">
            <div class="flex justify-between items-start mb-6">
              <h3 class="text-2xl font-semibold text-gray-900 hover:text-red-500 transition group-hover:text-red-500">
                <%= home.houseName %>
              </h3>
              <div class="flex items-center bg-gray-50 px-3 py-1.5 rounded-full shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" 
                  class="w-5 h-5 text-yellow-400">
                  <path fill-rule="evenodd" 
                    d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" 
                    clip-rule="evenodd" 
                  />
                </svg>
                <span class="ml-1.5 text-sm font-semibold text-gray-700">
                  <%= home.rating %>
                </span>
              </div>
            </div>

            <div class="flex items-center text-gray-600 mb-6">
              <div class="bg-gray-50 p-2 rounded-full">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" 
                  viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" 
                  />
                </svg>
              </div>
              <span class="ml-3 text-base"><%= home.location %></span>
            </div>

            <div class="flex justify-between items-center pt-4 border-t border-gray-100">
              <div class="text-red-500 font-bold">
                <span class="text-sm">RS.</span>
                <span class="text-2xl"><%= home.price %></span>
                <span class="text-gray-600 text-base font-normal">/ night</span>
              </div>
              
              <a href="/homes/<%= home._id %>" 
                class="inline-flex items-center px-6 py-3 bg-red-500 hover:bg-red-600 text-white rounded-full transition duration-300 text-sm font-semibold shadow-md hover:shadow-lg">
                View Details
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" 
                  viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                    d="M9 5l7 7-7 7" 
                  />
                </svg>
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </main>
</body>
</html>